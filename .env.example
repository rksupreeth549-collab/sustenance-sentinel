# Copy to .env and fill in. Demo runs OFFLINE without any of these set.

# Claude agent brains (Anthropic SDK). If unset, agents use rule-based fallbacks.
ANTHROPIC_API_KEY=

# Swiggy Food MCP server (localhost dev per https://mcp.swiggy.com/builders/).
# If unset, mcp_client uses the built-in MOCK Swiggy server (sample restaurants/menus).
SWIGGY_MCP_URL=
SWIGGY_MCP_TOKEN=

# Notification transport. If unset, notify.py prints to console (CONSOLE channel).
# Telegram (free, supports quick-reply buttons)
TELEGRAM_BOT_TOKEN=
# Twilio (SMS/WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
