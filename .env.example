# Copy to .env and fill in. Demo runs OFFLINE without any of these set.

# Claude agent brains (Anthropic SDK). If unset, agents use rule-based fallbacks.
ANTHROPIC_API_KEY=

# Swiggy Food MCP server (streamable HTTP, per https://mcp.swiggy.com/builders/docs/).
# If unset, mcp_client uses the built-in MOCK Swiggy server (sample restaurants/menus).
SWIGGY_MCP_URL=https://mcp.swiggy.com/food
SWIGGY_MCP_TOKEN=

# OAuth 2.1 + PKCE. Run `python -m sentinel.oauth` — it self-registers via Dynamic
# Client Registration (no client_id to request from anyone) and caches the token
# in .swiggy_auth.json. Access tokens last 5 days; v1.0 issues no refresh token,
# so re-run when it expires. Leave SWIGGY_MCP_TOKEN empty to use that cache.
SWIGGY_OAUTH_BASE=https://mcp.swiggy.com
SWIGGY_OAUTH_REDIRECT=http://localhost:8765/auth/callback
SWIGGY_OAUTH_SCOPE=mcp:tools

# DANGER: set to 1 only when you intend real orders, with real money, on a real
# account. Unset, place_food_order refuses to run. Leave empty while developing.
SWIGGY_ALLOW_REAL_ORDERS=

# Notification transport. If unset, notify.py prints to console (CONSOLE channel).
# Telegram (free, supports quick-reply buttons)
TELEGRAM_BOT_TOKEN=
# Twilio (SMS/WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
